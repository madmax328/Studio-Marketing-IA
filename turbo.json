{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "MONGODB_URI",
        "MONGODB_DB_NAME",
        "AUTH_SECRET",
        "APP_URL",
        "NEXT_PUBLIC_APP_URL",
        "EMAIL_FROM",
        "RESEND_API_KEY",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "ANTHROPIC_API_KEY",
        "AI_TEXT_PROVIDER",
        "AI_TEXT_MODEL",
        "AI_TEXT_EFFORT",
        "BLOB_READ_WRITE_TOKEN",
        "MEDIA_BLOB_ACCESS",
        "CRON_SECRET",
        "SOCIAL_TOKEN_ENCRYPTION_KEY",
        "SOCIAL_SIMULATION_ENABLED"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "TEST_MONGODB_URI"
      ]
    }
  },
  "globalPassThroughEnv": [
    "NEXT_TELEMETRY_DISABLED",
    "TURBO_TELEMETRY_DISABLED"
  ]
}
