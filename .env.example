# Copier ce fichier en apps/web/.env.local et remplir les valeurs.
# Ne jamais committer un fichier contenant de vraies valeurs.

# --- Base de données (MongoDB Atlas) ---
MONGODB_URI=
MONGODB_DB_NAME=studio_marketing_ia

# --- Authentification ---
# Générer avec : openssl rand -base64 32  (ou voir README pour PowerShell)
AUTH_SECRET=
# URL publique de l'application (http://localhost:3000 en local)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- E-mails transactionnels ---
# Renseigner SOIT le SMTP (ex. boîte Hostinger), SOIT Resend. Resend est prioritaire s'il est rempli.
# Sans aucun des deux : en développement, les e-mails s'affichent dans la console ;
# en production, l'inscription échoue (aucun e-mail ne peut être envoyé).
# EMAIL_FROM doit utiliser l'adresse de la boîte SMTP.
EMAIL_FROM=Studio Marketing IA <contact@votre-domaine.fr>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# --- IA : génération de texte ---
# Clé API Anthropic (console.anthropic.com). Sans clé, le studio indique que la génération n'est pas activée.
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut claude-opus-5-5). Moins cher : claude-sonnet-5-5 ou claude-haiku-5-5.
AI_TEXT_MODEL=claude-opus-5-5
# Niveau de réflexion : low, medium ou high (par défaut medium).
AI_TEXT_EFFORT=medium

# --- Stockage des médias (Vercel Blob) ---
# Ajouté automatiquement par Vercel quand un store Blob est connecté au projet (Storage > Blob).
BLOB_READ_WRITE_TOKEN=
# private (recommandé, fichiers servis uniquement aux membres de l'espace) ou public, selon le store créé.
MEDIA_BLOB_ACCESS=private

# --- Publication automatique ---
# Secret partagé avec le planificateur qui appelle /api/cron/publier chaque minute
# (en-tête « Authorization: Bearer <CRON_SECRET> »). 16 caractères minimum.
CRON_SECRET=
# Clé de chiffrement des jetons des réseaux sociaux : 32 octets en base64
# (PowerShell : [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))).
# Nécessaire dès qu'un vrai réseau est connecté. Ne jamais la changer sans migration : les jetons deviendraient illisibles.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Comptes de test qui simulent l'envoi sans rien publier (true par défaut). Mettre false avant l'ouverture commerciale.
SOCIAL_SIMULATION_ENABLED=true

# --- Création d'images par IA (facultatif : sans clé, la fonction reste masquée) ---
# Clé API OpenAI (platform.openai.com → API keys). Modèle et qualité modifiables.
OPENAI_API_KEY=
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_QUALITY=medium

# --- Connecteurs réels (chaque réseau s'active dès que ses identifiants sont renseignés) ---
# Adresses de retour à déclarer dans chaque application : https://<domaine>/api/reseaux/retour/meta, …/threads, …/linkedin
# Application Meta (Facebook Login) : Pages Facebook et comptes Instagram professionnels.
META_APP_ID=
META_APP_SECRET=
# Version de la Graph API (v24.0 par défaut).
META_GRAPH_VERSION=
# Threads : identifiants propres au cas d'usage « Threads API » de l'application Meta.
THREADS_APP_ID=
THREADS_APP_SECRET=
# Application LinkedIn (produits « Sign In with LinkedIn using OpenID Connect » et « Share on LinkedIn »).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Version de l'API LinkedIn, au format AAAAMM (202609 par défaut).
LINKEDIN_API_VERSION=

# --- Tests d'intégration (optionnel en local, utilisé par la CI) ---
TEST_MONGODB_URI=

# --- Abonnements (Stripe) ---
# Clé secrète (sk_test_… en test, sk_live_… en production) et secret du webhook (whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix récurrents créés dans Stripe (price_…), un par offre payante.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_AGENCY=

# --- Prochaines étapes (non utilisées pour l'instant) ---
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
