# Copier ce fichier en apps/web/.env.local et remplir les valeurs.
# Ne jamais committer un fichier contenant de vraies valeurs.

# --- Base de données (MongoDB Atlas) ---
MONGODB_URI=
MONGODB_DB_NAME=studio_marketing_ia

# --- Authentification ---
# Générer avec : openssl rand -base64 32  (ou voir README pour PowerShell)
AUTH_SECRET=
# URL publique de l'application (http://localhost:3000 en local)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- E-mails transactionnels (Resend) ---
# Sans clé en développement : les e-mails sont affichés dans la console du serveur.
# Obligatoire en production.
RESEND_API_KEY=
EMAIL_FROM=Studio Marketing IA <no-reply@votre-domaine.fr>

# --- Tests d'intégration (optionnel en local, utilisé par la CI) ---
TEST_MONGODB_URI=

# --- Prochaines étapes (non utilisées pour l'instant) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MEDIA_STORAGE_ENDPOINT=
# MEDIA_STORAGE_BUCKET=
# MEDIA_STORAGE_ACCESS_KEY=
# MEDIA_STORAGE_SECRET_KEY=
